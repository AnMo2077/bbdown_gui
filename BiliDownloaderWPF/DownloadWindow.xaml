<Window x:Class="BiliDownloaderWPF.DownloadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BiliDownloaderWPF"
        mc:Ignorable="d"
        Title="Download Video"
        Height="400"
        Width="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    
    <Window.Resources>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#0078D7"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#005A9E"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#E1E1E1"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#CCCCCC"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    
    <Grid Padding="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- URL Input -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Enter Bilibili video URL:" FontSize="14" FontWeight="Bold" Margin="0,0,0,5"/>
            <TextBox x:Name="UrlTextBox" Width="450" Height="35" FontSize="14" Padding="10"/>
        </StackPanel>
        
        <!-- Part Selection -->
        <StackPanel Grid.Row="1" Margin="0,0,0,15">
            <TextBlock Text="Select Part:" FontSize="14" FontWeight="Bold" Margin="0,0,0,5"/>
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="AllPartsRadio" Content="Download All" IsChecked="True" Margin="0,0,20,0"/>
                <RadioButton x:Name="SpecificPartsRadio" Content="Download Specific Part"/>
            </StackPanel>
        </StackPanel>
        
        <!-- Part Range -->
        <StackPanel Grid.Row="2" Margin="0,0,0,20">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <TextBlock Text="Start:" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <TextBox x:Name="StartPartTextBox" Width="60" Height="30" Text="1"/>
                <TextBlock Text="-" Margin="10,0,10,0" VerticalAlignment="Center"/>
                <TextBlock Text="End:" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <TextBox x:Name="EndPartTextBox" Width="60" Height="30" Text="10"/>
            </StackPanel>
        </StackPanel>
        
        <!-- Progress -->
        <StackPanel Grid.Row="3" Margin="0,0,0,20">
            <TextBlock x:Name="ProgressText" Text="Ready" Margin="0,0,0,5"/>
            <ProgressBar x:Name="ProgressBar" Width="450" Height="20" Minimum="0" Maximum="100" Value="0"/>
        </StackPanel>
        
        <!-- Status -->
        <ScrollViewer Grid.Row="4" Margin="0,0,0,20">
            <TextBlock x:Name="StatusText" Text="" TextWrapping="Wrap"/>
        </ScrollViewer>
        
        <!-- Buttons -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Style="{StaticResource PrimaryButton}" Content="Start Download" Click="StartDownloadButton_Click" Width="150"/>
            <Button Style="{StaticResource SecondaryButton}" Content="Cancel" Click="CancelButton_Click" Width="100"/>
        </StackPanel>
    </Grid>
</Window>